        <div class="ex-code">:root {
  --c-error:   #e63946;
  --c-success: #2a9d8f;
  --c-warning: #e9c46a;
  --c-purple:  #c77dff;
  --c-mint:    #06d6a0;
}

.error   { color: var(--c-error); }
.success { color: var(--c-success); }
.warning { color: var(--c-warning); }</div>
