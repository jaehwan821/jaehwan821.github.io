<!DOCTYPE html>
<!-- ========================================================= 
[자바스크립트(JavaScript) 핵심 정리 및 삽입 방법 통합]
1. HTML은 내용, CSS는 디자인/구조, JS는 동작과 반응 담당
2. 넷스케이프의 브렌던 아이크가 개발, ECMAScript 표준 사용
3. 주요 특징: 컴파일 없이 브라우저에서 실행되는 인터프리터 언어
4. 자바스크립트 삽입 방법 3가지:
   - 외부 자바스크립트: <head> 내에 <script src="파일경로"></script>
   - 내부 자바스크립트: <head> 내에 <script> 태그로 직접 작성
   - 본문 자바스크립트: <body> 내에 직접 <script> 작성
========================================================= -->
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>자바스크립트 삽입 방법 통합 예제</title>
    
    <!-- [방법 1] 외부 자바스크립트 연결 -->
    <!-- src 속성에 외부 JS 파일 경로를 지정하여 불러옵니다. -->
    <script src="예제8-2externjs.js"></script>

    <!-- [방법 2] 내부 자바스크립트 작성 (Head 영역) -->
    <script>
        /* <head> 태그 안에서 실행되는 내부 자바스크립트 */
        console.log("Head 영역의 내부 자바스크립트가 로드되었습니다.");
    </script>
</head>
<body>
    <!-- HTML 본문 -->
    <h1>AI JavaScript Page</h1>

    <!-- [방법 3] 본문(Body) 내 자바스크립트 작성 -->
    <!-- <body> 태그 안쪽에 직접 <script>를 작성하여 출력합니다. -->
    <script>
        /* document.write() : HTML 문서에 텍스트 출력 */
        document.write("My First JavaScript Using AI (Body 스크립트 출력)");
    </script>
</body>
</html>
